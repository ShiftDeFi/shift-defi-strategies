# Config for tools/merkl-claim.mjs. Copy to tools/merkl-claim.env (gitignored) and fill in.
# `npm run claim` sources this file into the environment; the repo-wide .env is not involved.
# It is read by sh, so keep values quoted — anything with a space or a shell metacharacter breaks
# an unquoted assignment.

# Mainnet RPC for the pre-flight checks and the proposal digest. An exported $ETH_RPC_URL is used
# as a fallback if this is unset, so you can rely on your shell instead of duplicating the URL here.
MERKL_CLAIM_RPC_URL=""

# One entry per MorphoVault proxy to claim for. The alias after the prefix is what you pass on the
# command line (lowercased), and _LABEL is the heading it prints under. Runs are ordered by alias.
MERKL_STRATEGY_PYUSD="0x0000000000000000000000000000000000000000"
MERKL_STRATEGY_PYUSD_LABEL="MorphoVault PYUSD"
MERKL_STRATEGY_RLUSD="0x0000000000000000000000000000000000000000"
MERKL_STRATEGY_RLUSD_LABEL="MorphoVault RLUSD"

# The Safe holding MERKLE_CLAIMER_ROLE on those strategies: what --propose queues onto, and the
# address the pre-flight simulates the claim from.
# Safe's MultiSendCallOnly singleton for that Safe's version, used to batch the claims into one
# transaction. `cast call <safe> "VERSION()(string)"` if you are unsure which one you need.
MERKL_CLAIM_MULTISEND="0x0000000000000000000000000000000000000000"

MERKL_CLAIM_SAFE="0x0000000000000000000000000000000000000000"

# `cast wallet list` account that signs proposals. Must be a delegate (or an owner) of the Safe.
SAFE_PROPOSER_ACCOUNT=""

# Optional.
# SAFE_PROPOSER_PASSWORD_FILE=/path/to/password   # unattended keystore unlock, for CI
# SAFE_API_KEY=                                   # developer.safe.global, lifts the rate limit
