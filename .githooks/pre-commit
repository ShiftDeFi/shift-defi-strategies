#!/usr/bin/env bash
set -u

# Only Solidity changes need the checks below.
[ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.sol')" ] && exit 0

if ! forge fmt --check >/dev/null 2>&1; then
    echo "pre-commit: forge fmt --check failed; run 'just fmt' and stage the result" >&2
    exit 1
fi

if ! out=$(forge build contracts --sizes 2>&1); then
    { echo "pre-commit: forge build contracts --sizes failed:"; tail -n 40 <<<"$out"; } >&2
    exit 1
fi
